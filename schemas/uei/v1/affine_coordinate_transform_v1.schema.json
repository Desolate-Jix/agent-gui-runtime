{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "affine_coordinate_transform_v1",
  "type": "object",
  "required": [
    "contract_version",
    "source_space",
    "target_space",
    "source_size",
    "target_size",
    "scale",
    "offset",
    "rounding",
    "clipping",
    "source_capture_artifact_sha256",
    "target_capture_artifact_sha256",
    "content_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "affine_coordinate_transform_v1"
    },
    "source_space": {
      "type": "string",
      "enum": [
        "screen_pixel_xyxy",
        "window_outer_pixel_xyxy",
        "window_client_pixel_xyxy",
        "capture_pixel_xyxy",
        "image_pixel_xyxy",
        "image_normalized_xyxy"
      ]
    },
    "target_space": {
      "type": "string",
      "enum": [
        "screen_pixel_xyxy",
        "window_outer_pixel_xyxy",
        "window_client_pixel_xyxy",
        "capture_pixel_xyxy",
        "image_pixel_xyxy",
        "image_normalized_xyxy"
      ]
    },
    "source_size": {
      "$ref": "#/$defs/size"
    },
    "target_size": {
      "$ref": "#/$defs/size"
    },
    "scale": {
      "$ref": "#/$defs/point"
    },
    "offset": {
      "$ref": "#/$defs/point"
    },
    "rounding": {
      "type": "string",
      "enum": [
        "outward",
        "nearest",
        "none"
      ]
    },
    "clipping": {
      "type": "string",
      "enum": [
        "reject_if_outside",
        "clip_to_target"
      ]
    },
    "source_capture_artifact_sha256": {
      "$ref": "#/$defs/sha"
    },
    "target_capture_artifact_sha256": {
      "$ref": "#/$defs/sha"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "immutable_ref": {
      "type": "object",
      "required": [
        "id",
        "content_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "content_sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "additionalProperties": false
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      },
      "minItems": 4,
      "maxItems": 4
    },
    "opaque_string": {
      "type": "string",
      "maxLength": 4096
    },
    "opaque_scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "number",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "opaque_value": {
      "oneOf": [
        {
          "$ref": "#/$defs/opaque_scalar"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opaque_value"
          },
          "maxItems": 256
        },
        {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/opaque_value"
          }
        }
      ]
    }
  }
}
