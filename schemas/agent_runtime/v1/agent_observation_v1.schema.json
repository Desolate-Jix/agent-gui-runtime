{
  "$comment": "Closed structural transport schema. Pydantic validators are authoritative for cross-field semantics.",
  "$defs": {
    "AgentAvailableActionV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "requires_user_confirmation": {
          "title": "Requires User Confirmation",
          "type": "boolean"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "semantic_action": {
          "enum": [
            "open_detail",
            "open_apply_flow",
            "back",
            "close_modal",
            "safe_stop"
          ],
          "title": "Semantic Action",
          "type": "string"
        },
        "target_state_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target State Id"
        }
      },
      "required": [
        "action_id",
        "semantic_action",
        "description",
        "target_state_id",
        "risk_level",
        "requires_user_confirmation"
      ],
      "title": "AgentAvailableActionV1",
      "type": "object"
    },
    "AgentCaptureRefV1": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Capture Id",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Evidence Ref",
          "type": "string"
        },
        "screenshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Screenshot Sha256",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "screenshot_sha256",
        "evidence_ref"
      ],
      "title": "AgentCaptureRefV1",
      "type": "object"
    },
    "AgentSafeStopBoundaryV1": {
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "enum": [
            "none",
            "state_ambiguous",
            "state_unknown",
            "stop_boundary",
            "no_available_action",
            "policy_blocked",
            "human_review_required"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "reason_code"
      ],
      "title": "AgentSafeStopBoundaryV1",
      "type": "object"
    },
    "AgentStateMatchV1": {
      "additionalProperties": false,
      "properties": {
        "resolution_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolution Sha256"
        },
        "state_availability": {
          "anyOf": [
            {
              "enum": [
                "reviewed",
                "stop_boundary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Availability"
        },
        "state_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Id"
        },
        "status": {
          "enum": [
            "matched",
            "ambiguous",
            "unknown",
            "stop_boundary"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "state_id",
        "state_availability",
        "resolution_sha256"
      ],
      "title": "AgentStateMatchV1",
      "type": "object"
    },
    "WorkflowRefV1": {
      "additionalProperties": false,
      "properties": {
        "asset_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Content Sha256",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "reviewed_revision_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reviewed Revision Hash",
          "type": "string"
        },
        "source_workflow_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Workflow Sha256",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "asset_id",
        "asset_content_sha256",
        "source_workflow_sha256",
        "reviewed_revision_hash"
      ],
      "title": "WorkflowRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_is_authorization": {
      "const": false,
      "title": "Artifact Is Authorization",
      "type": "boolean"
    },
    "available_actions": {
      "items": {
        "$ref": "#/$defs/AgentAvailableActionV1"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Available Actions",
      "type": "array"
    },
    "contract_version": {
      "const": "agent_observation_v1",
      "title": "Contract Version",
      "type": "string"
    },
    "current_capture": {
      "$ref": "#/$defs/AgentCaptureRefV1"
    },
    "observation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Observation Id",
      "type": "string"
    },
    "safe_stop": {
      "$ref": "#/$defs/AgentSafeStopBoundaryV1"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Session Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/AgentStateMatchV1"
    },
    "state_resolution_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "State Resolution Ref",
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowRefV1"
    }
  },
  "required": [
    "contract_version",
    "observation_id",
    "session_id",
    "workflow",
    "state_resolution_ref",
    "current_capture",
    "state",
    "available_actions",
    "safe_stop",
    "artifact_is_authorization"
  ],
  "title": "AgentObservationV1",
  "type": "object"
}
