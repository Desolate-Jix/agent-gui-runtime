{
  "$comment": "Closed structural transport schema. Pydantic validators are authoritative for cross-field semantics.",
  "$defs": {
    "AgentApplicationIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "identity_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Identity Ref",
          "type": "string"
        },
        "kind": {
          "enum": [
            "web",
            "native"
          ],
          "title": "Kind",
          "type": "string"
        },
        "display_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        }
      },
      "required": [
        "identity_ref",
        "kind",
        "display_name"
      ],
      "title": "AgentApplicationIdentityV1",
      "type": "object"
    },
    "AgentAvailableActionV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "semantic_action": {
          "enum": [
            "open_detail",
            "open_apply_flow",
            "back",
            "close_modal",
            "safe_stop"
          ],
          "title": "Semantic Action",
          "type": "string"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "target_state_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target State Id"
        },
        "expected_effect": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },
        "verification_rule_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Verification Rule Refs",
          "type": "array"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "requires_user_confirmation": {
          "title": "Requires User Confirmation",
          "type": "boolean"
        }
      },
      "required": [
        "action_id",
        "semantic_action",
        "description",
        "target_state_id",
        "expected_effect",
        "verification_rule_refs",
        "risk_level",
        "requires_user_confirmation"
      ],
      "title": "AgentAvailableActionV1",
      "type": "object"
    },
    "AgentBlockerV1": {
      "additionalProperties": false,
      "properties": {
        "blocker_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Blocker Id",
          "type": "string"
        },
        "blocker_type": {
          "enum": [
            "state",
            "review",
            "policy",
            "action"
          ],
          "title": "Blocker Type",
          "type": "string"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "safe_stop_required": {
          "title": "Safe Stop Required",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "blocker_id",
        "blocker_type",
        "description",
        "safe_stop_required",
        "evidence_refs"
      ],
      "title": "AgentBlockerV1",
      "type": "object"
    },
    "AgentCaptureRefV1": {
      "additionalProperties": false,
      "properties": {
        "capture_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Capture Id",
          "type": "string"
        },
        "screenshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Screenshot Sha256",
          "type": "string"
        },
        "evidence_ref": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Evidence Ref",
          "type": "string"
        }
      },
      "required": [
        "capture_id",
        "screenshot_sha256",
        "evidence_ref"
      ],
      "title": "AgentCaptureRefV1",
      "type": "object"
    },
    "AgentSafeStopBoundaryV1": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "reason_code": {
          "enum": [
            "none",
            "state_ambiguous",
            "state_unknown",
            "stop_boundary",
            "no_available_action",
            "policy_blocked",
            "human_review_required"
          ],
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "required",
        "reason_code"
      ],
      "title": "AgentSafeStopBoundaryV1",
      "type": "object"
    },
    "AgentSemanticFactV1": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Fact Id",
          "type": "string"
        },
        "fact_type": {
          "enum": [
            "identity_anchor",
            "current_content",
            "reviewed_context"
          ],
          "title": "Fact Type",
          "type": "string"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "observation_status": {
          "enum": [
            "reviewed",
            "current",
            "current_redacted",
            "requires_observation"
          ],
          "title": "Observation Status",
          "type": "string"
        },
        "capture_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capture Id"
        },
        "value_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Sha256"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_type",
        "label",
        "value",
        "observation_status",
        "capture_id",
        "value_sha256",
        "evidence_refs"
      ],
      "title": "AgentSemanticFactV1",
      "type": "object"
    },
    "AgentStateMatchV1": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "matched",
            "ambiguous",
            "unknown",
            "stop_boundary"
          ],
          "title": "Status",
          "type": "string"
        },
        "state_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Id"
        },
        "state_availability": {
          "anyOf": [
            {
              "enum": [
                "reviewed",
                "stop_boundary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State Availability"
        },
        "resolution_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolution Sha256"
        },
        "source_interface_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Interface Id"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Name"
        },
        "surface_type": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Surface Type"
        },
        "responsibility": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Responsibility"
        }
      },
      "required": [
        "status",
        "state_id",
        "state_availability",
        "resolution_sha256",
        "source_interface_id",
        "display_name",
        "surface_type",
        "responsibility"
      ],
      "title": "AgentStateMatchV1",
      "type": "object"
    },
    "WorkflowRefV1": {
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workflow Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Content Sha256",
          "type": "string"
        },
        "source_workflow_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Workflow Sha256",
          "type": "string"
        },
        "reviewed_revision_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reviewed Revision Hash",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "asset_id",
        "asset_content_sha256",
        "source_workflow_sha256",
        "reviewed_revision_hash"
      ],
      "title": "WorkflowRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "agent_observation_v1",
      "title": "Contract Version",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Observation Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Session Id",
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowRefV1"
    },
    "application": {
      "$ref": "#/$defs/AgentApplicationIdentityV1"
    },
    "state_resolution_ref": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "title": "State Resolution Ref",
      "type": "string"
    },
    "current_capture": {
      "$ref": "#/$defs/AgentCaptureRefV1"
    },
    "state": {
      "$ref": "#/$defs/AgentStateMatchV1"
    },
    "semantic_facts": {
      "items": {
        "$ref": "#/$defs/AgentSemanticFactV1"
      },
      "maxItems": 64,
      "title": "Semantic Facts",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 2,
      "title": "Evidence Refs",
      "type": "array"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/AgentBlockerV1"
      },
      "maxItems": 32,
      "title": "Blockers",
      "type": "array"
    },
    "available_actions": {
      "items": {
        "$ref": "#/$defs/AgentAvailableActionV1"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Available Actions",
      "type": "array"
    },
    "safe_stop": {
      "$ref": "#/$defs/AgentSafeStopBoundaryV1"
    },
    "artifact_is_authorization": {
      "const": false,
      "title": "Artifact Is Authorization",
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "observation_id",
    "session_id",
    "workflow",
    "application",
    "state_resolution_ref",
    "current_capture",
    "state",
    "semantic_facts",
    "evidence_refs",
    "blockers",
    "available_actions",
    "safe_stop",
    "artifact_is_authorization"
  ],
  "title": "AgentObservationV1",
  "type": "object"
}
