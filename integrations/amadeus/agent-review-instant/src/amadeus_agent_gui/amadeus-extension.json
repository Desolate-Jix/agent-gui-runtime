{
  "schema": "amadeus.extension/v0",
  "id": "io.github.desolate-jix.gui-runtime",
  "version": "0.0.4",
  "display_name": {
    "en": "Windows GUI Runtime",
    "zh-CN": "Windows GUI 执行运行时"
  },
  "description": {
    "en": "Connect Pi to an operator-started, authenticated local Runtime over native HTTP MCP; includes an execution lifecycle Skill.",
    "zh-CN": "通过原生 HTTP MCP 将 Pi 连接到操作员独立启动、带鉴权的本机 Runtime，并提供执行收尾 Skill。"
  },
  "author": {
    "name": "Desolate-Jix"
  },
  "license": "ISC",
  "engines": {
    "amadeus_host_api": ">=0.1,<0.2",
    "platforms": [
      "win32"
    ]
  },
  "runtime": {
    "kind": "none"
  },
  "config": {
    "runtime_url": {
      "type": "string",
      "title": "Trusted loopback MCP URL / 可信本机 MCP 地址",
      "required": true,
      "default": "http://127.0.0.1:17665/mcp"
    },
    "connection_token": {
      "type": "string",
      "title": "Local MCP connection token (not a model API key) / 本机连接密钥（不是模型 API key）",
      "required": true,
      "secret": true
    }
  },
  "contributes": {
    "mcp_server": [
      {
        "id": "execution",
        "contract": "amadeus.mcp-server/v0",
        "transport": "http",
        "url": "${config.runtime_url}",
        "bearer_token": "${config.connection_token}"
      }
    ],
    "skill": [
      {
        "id": "gui-execution",
        "contract": "amadeus.skill/v0",
        "path": "skills/gui-execution",
        "title": {
          "en": "GUI execution",
          "zh-CN": "GUI 执行"
        }
      }
    ]
  },
  "permissions": {
    "host": [],
    "os": {
      "network": [
        "*"
      ]
    }
  }
}
